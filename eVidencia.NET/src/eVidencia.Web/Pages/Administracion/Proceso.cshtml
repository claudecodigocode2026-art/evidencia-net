@page "/Administracion/Proceso.aspx"
@model eVidencia.Web.Pages.Administracion.ProcesoModel
@*
    Alta y edición de un Proceso.
    Funcionalidad: eVidencias.Web/Administracion/Proceso.aspx.
    Diseño: mockup "eVidencia · Mockup responsive", pantalla "Ficha · Proceso".
*@
<section class="ev-screen ev-page" data-screen-label="Proceso">
  <h1 class="ev-page-title">Proceso@(Model.Accion == Accion.Crear ? " (alta)" : "")</h1>
  <form method="post" id="formProceso" novalidate>
    <input type="hidden" name="hdnAccion" value="@Model.Accion" />
    <input type="hidden" name="hdnIdProceso" value="@Model.IdProceso" />
    <div class="ev-card">
      <div class="ev-form-grid">
        <div class="ev-field @(Model.ErrorEnCodigo ? "has-error" : "")">
          <label class="ev-label" for="txtCodigo">Código</label>
          <div class="ev-inline"><input class="ev-input" name="txtCodigo" id="txtCodigo" maxlength="10" value="@Model.Codigo" autocomplete="off" /></div>
        </div>
        <div class="ev-field @(Model.ErrorEnNombre ? "has-error" : "")">
          <label class="ev-label" for="txtNombre">Nombre</label>
          <div class="ev-inline"><input class="ev-input" name="txtNombre" id="txtNombre" value="@Model.Nombre" autocomplete="off" /></div>
        </div>
        <div class="ev-field @(Model.ErrorEnTipoProceso ? "has-error" : "")">
          <label class="ev-label" for="ddTipoProceso">Tipo de Proceso</label>
          <div class="ev-inline">
            <select class="ev-select" name="ddTipoProceso" id="ddTipoProceso">
              <option value="-1" selected="@(Model.TipoProceso == "-1")">[Seleccione]</option>
              @foreach (var tipo in Model.TiposDeProceso)
              {
                <option value="@tipo.IdTipoDeProceso" selected="@(Model.TipoProceso == tipo.IdTipoDeProceso.ToString())">@tipo.Nombre</option>
              }
            </select>
          </div>
        </div>
      </div>
    </div>
    <div class="ev-actions" style="margin-top:16px">
      <button type="submit" class="ev-btn ev-btn--primary" id="btnGuardar">Guardar</button>
      <a class="ev-btn ev-btn--ghost" id="btnVolver" href="/Administracion/Procesos.aspx">Volver</a>
    </div>
  </form>
</section>
