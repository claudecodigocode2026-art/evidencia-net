@using eVidencia.BLL
@using eVidencia.Entidades
@inject GestorUsuarios GestorUsuarios
@inject eVidencia.Web.Servicios.InfoDemo InfoDemo
@{
    // Estructura común de la aplicación. Diseño: mockup "eVidencia · Mockup responsive".
    // Datos de usuario: como en eVidencias.Master.cs (usuario autenticado y su perfil).
    USUARIO usuario = GestorUsuarios.ConsultarUsuarioAutenticado();
    string nombreCompleto = (usuario.Nombre + " " + usuario.Apellidos).Trim();
    string iniciales = (usuario.Nombre.Trim().FirstOrDefault().ToString() + usuario.Apellidos.Trim().FirstOrDefault()).ToUpper();
    string? scriptInicio = ViewData["ScriptInicio"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/css/evidencia.css?v=1" />
    <script src="/js/evidencia.js?v=1"></script>
    @await RenderSectionAsync("head", required: false)
</head>
<body>
<div class="ev-app" data-theme="claro">
  <div class="ev-shell">
    <header class="ev-topbar">
      <button type="button" class="ev-btn ev-btn--ghost ev-btn--icon ev-menu-btn" aria-label="Abrir menú" aria-expanded="false"><svg class="ev-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg></button>
      <nav class="ev-tabs" aria-label="Módulos">
        <button type="button" class="ev-tab" data-sec="auditores" aria-current="false"><svg class="ev-i ev-tab__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6v3H9zM9 4.5H6V21h12V4.5h-3M9 11h6M9 15h6"></path></svg><span>Auditores</span></button>
        <button type="button" class="ev-tab" data-sec="reportes" aria-current="false"><svg class="ev-i ev-tab__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V10M12 20V4M19 20v-7"></path></svg><span>Reportes</span></button>
        <button type="button" class="ev-tab is-on" data-sec="administracion" aria-current="page"><svg class="ev-i ev-tab__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"></path></svg><span>Administración</span></button>
      </nav>
      <div class="ev-topright">
        <span class="ev-avatar" title="@nombreCompleto">@iniciales</span>
        <button type="button" class="ev-btn ev-btn--ghost ev-btn--icon" aria-label="Cerrar Sesión" title="Usuario fijo: no hay inicio ni cierre de sesión en la demo"><svg class="ev-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 8l-4 4 4 4M6 12h10"></path></svg></button>
        <img class="ev-toplogo ev-desktop-only" src="/img/telefonica-logo.png" alt="Telefónica" />
        <span class="ev-topsep ev-desktop-only" aria-hidden="true"></span>
        <a class="ev-wordmark" href="/Administracion/Procesos.aspx" aria-label="eVidencia"><span class="ev-wordmark__dot"></span><span>eVidencia</span></a>
      </div>
    </header>
    <nav class="ev-nav" aria-label="Menú principal">
      <button type="button" class="ev-btn ev-btn--ghost ev-btn--icon ev-nav__close" aria-label="Cerrar menú"><svg class="ev-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg></button>
      <partial name="_Menu" />
      <div class="ev-nav__foot">
        <span class="ev-nav__user"><b>@nombreCompleto</b>@(usuario.PERFIL_DE_USUARIO?.Nombre)</span>
        <span class="ev-today">@DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy")</span>
        <div class="ev-flags">
          <button type="button" class="ev-flagbtn" aria-label="Español" aria-pressed="true" title="Español"><img class="ev-flag is-on" src="/img/flag-es.png" alt="" /></button>
          <button type="button" class="ev-flagbtn" aria-label="Português" aria-pressed="false" title="Idioma no incluido en la demo"><img class="ev-flag" src="/img/flag-br.png" alt="" /></button>
          <button type="button" class="ev-flagbtn" aria-label="English" aria-pressed="false" title="Idioma no incluido en la demo"><img class="ev-flag" src="/img/flag-gb.png" alt="" /></button>
        </div>
        <button type="button" class="ev-btn ev-btn--secondary" title="Usuario fijo: no hay inicio ni cierre de sesión en la demo"><svg class="ev-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 8l-4 4 4 4M6 12h10"></path></svg>Cerrar Sesión</button>
      </div>
    </nav>
    <main class="ev-main">
      @RenderBody()
      <footer class="ev-foot">
        <span>© Telefónica S.A.</span><span aria-hidden="true">·</span><span>Todos los derechos reservados</span>
        <span class="ev-foot__demo">Demo de migración a .NET @InfoDemo.VersionNet · Funcionalidad migrada: Sociedades, Procesos, Subprocesos y Tipos de Auditoría · Usuario fijo, sin pantalla de acceso · Datos: @InfoDemo.DescripcionDatos</span>
      </footer>
    </main>
  </div>
  @if (!string.IsNullOrEmpty(scriptInicio))
  {
    <script>document.addEventListener('DOMContentLoaded', function () { @Html.Raw(scriptInicio) });</script>
  }
</div>
</body>
</html>
