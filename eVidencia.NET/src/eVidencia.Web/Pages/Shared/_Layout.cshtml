    <script type="text/javascript">
        function MostarExcepciones(titulo, mensaje) {
            $("#dialog-excepciones").attr("title", titulo);
            $("#dialog-excepciones p").text(mensaje);
            $("#dialog-excepciones").dialog({
                modal: true,
                width: 350,
                buttons: {
                    Ok: function () {
                        $(this).dialog("close");
                    }
                }
            });
        }

        function MostarNotificacion(titulo, mensaje) {
            $("#dialog-excepciones").attr("title", titulo);
            $("#dialog-excepciones p").text(mensaje);
            $("#dialog-excepciones").dialog({
                modal: true,
                width: 350,
                buttons: {
                    Ok: function () {
                        $(this).dialog("close");
                    }
                }
            });
        }

        function MostrarNotificacionHtml(titulo, mensaje) {
            $("#dialog-excepciones").attr("title", titulo);
            $("#dialog-excepciones p").html(mensaje);
            $("#dialog-excepciones").dialog({
                modal: true,
                width: 350,
                buttons: {
                    Ok: function () {
                        $(this).dialog("close");
                    }
                }
            });
        }

        function MostrarAlerta(mensaje, titulo) {
            if (titulo) {
                $("#dialog-excepciones").attr("title", titulo);
            }
            else {
                $("#dialog-excepciones").attr("title", "Error");
            }
            $("#dialog-excepciones p").text(mensaje);
            $("#dialog-excepciones").dialog({
                modal: true,
                width: 350,
                buttons: {
                    Ok: function () {
                        $(this).dialog("close");
                    }
                }
            });
        }

        function MostrarConfirmar(mensaje, titulo) {
            var defer = $.Deferred();
            if (titulo) {
                $("#dialog-confirmar").attr("title", titulo);
            }
            else {
                $("#dialog-confirmar").attr("title", "Se necesita confirmación");
            }
            $("#dialog-confirmar p").text(mensaje);
            $("#dialog-confirmar").dialog({
                modal: true,
                width: 350,
                buttons: {
                    "Sí": function () {
                        defer.resolve(true);
                        $(this).dialog("close");
                    },
                    "No": function () {
                        defer.resolve(false);
                        $(this).dialog("close");
                    }
                },
                close: function () {
                    $(this).dialog("close");
                }
            });
            return defer.promise();
        }

        function Notificar(titulo, mensaje) {
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "positionClass": "toast-top-right",
                "onclick": null,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };
            toastr.success(mensaje, titulo);
        }

        $(function () { ConfigurarDatepicker(); });

        function ConfigurarDatepicker() {
            $(".datepicker").keydown(function () {
                $(this).val('');
                return false;
            });

            $(".datepicker").datepicker({
                showMonthAfterYear: false,
                changeYear: true,
                showOn: "both",
                buttonText: "",
                buttonImage: "/Images/CalendarImage.png",
                buttonImageOnly: true
            });

            $(".datetimepicker").keydown(function () {
                $(this).val('');
                return false;
            });

            $(".datetimepicker").datetimepicker({ //closeText: "Cerrar",
                showMonthAfterYear: false,
                changeYear: true,
                showOn: "both",
                buttonText: "",
                buttonImage: "/Images/CalendarImage.png",
                buttonImageOnly: true,
            });
        }

        function ConvertirFecha(fecha) {
            var fechaJSON;

            if (fecha != null) {

                var dia = fecha.getDate();
                var mes = (fecha.getMonth() + 1);
                var anyo = fecha.getFullYear();
                var hora = fecha.getHours().toString();
                var minutos = fecha.getMinutes().toString();

                if (hora.length == 1) {
                    hora = "0" + hora;
                }
                if (minutos.length == 1) {
                    minutos = "0" + minutos;
                }

                fechaJSON = anyo + "-" + mes + "-" + dia + "T" + hora + ":" + minutos;     // ej Fecha formato Json"2014-08-21T22:00:00.000Z"
            }
            else {
                fechaJSON = "";
            }
            return fechaJSON;
        }

        String.format = function () {
            var s = arguments[0];
            for (var i = 0; i < arguments.length - 1; i++) {
                var reg = new RegExp("\\{" + i + "\\}", "gm");
                s = s.replace(reg, arguments[i + 1]);
            }
            return s;
        }

        function CallEnterKeyFunc(key) {
            if (key == 13) {
                event.returnValue = false;
                event.cancel = true;
                Filtrar();
            }
            else {
                return true;
            }
        }

        // Guarda en una cookie la configuración del grid y los valores de los controles de la zona de filtros.
        function GuardarConfiguracionJQGrid(IdPagina, IdJQGrid) {
            var config = {
                filtros: {},
                page: $(IdJQGrid).jqGrid('getGridParam', 'page'),
                rowNum: $(IdJQGrid).jqGrid('getGridParam', 'rowNum'),
                sortname: $(IdJQGrid).jqGrid('getGridParam', 'sortname'),
                sortorder: $(IdJQGrid).jqGrid('getGridParam', 'sortorder'),
            }

            // Guardamos los valores de los campos de texto y desplegables de la zona de filtros
            $('.filtros').find('input[type=text],select').each(function (index) {
                config.filtros[$(this).attr('id')] = $(this).val();
            });

            createCookie(IdPagina + '_gridconfig', JSON.stringify(config), 1);
        }

        // Recupera la configuración del grid en la variable gridConfig, y recupera los valores de los controles de la zona de filtros.
        function RecuperarConfiguracionJQGrid(IdPagina, EsVolver) {
            if (EsVolver) {
                gridConfig = JSON.parse(readCookie(IdPagina + '_gridconfig'));

                if (gridConfig == null) {
                    eraseCookie(IdPagina + '_gridconfig');
                    ReiniciarConfiguracionJQGrid();
                }
            } else {
                eraseCookie(IdPagina + '_gridconfig');
                ReiniciarConfiguracionJQGrid();
            }

            // Establecemos la configuración de los filtros
            for (var propertyName in gridConfig.filtros) {
                $('#' + propertyName).val(gridConfig.filtros[propertyName]);
            }
        }

        // Establece la configuración inicial del JQGrid
        function ReiniciarConfiguracionJQGrid() {
            gridConfig = {
                filtros: {},
                page: 1,
                rowNum: 20,
                sortname: gridSortnameInicial,
                sortorder: gridSortorderInicial
            }
        }

        function createCookie(name, value, days) {
            var expires;

            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toGMTString();
            } else {
                expires = "";
            }
            document.cookie = escape(name) + "=" + escape(value) + expires + "; path=/";
        }

        function readCookie(name) {
            var nameEQ = escape(name) + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) === ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) === 0) return unescape(c.substring(nameEQ.length, c.length));
            }
            return null;
        }

        function eraseCookie(name) {
            createCookie(name, "", -1);
        }

         //función que cambia el tipo del elemento al tipo que le pasamos por parámetro, este método se debe llamar desde
         //un $.each, porque si no machaca todos los atributos con los atributos del primer elemento
        (function ($) {
            $.fn.changeElementType = function (newType) {
                var attrs = {};
                if(this.length > 0){
                    $.each(this[0].attributes, function (idx, attr) {
                        attrs[attr.nodeName] = attr.nodeValue;
                    });

                    this.replaceWith(function () {
                        return $("<" + newType + "/>", attrs).append($(this).contents());
                    });
                }
            }
        })(jQuery);

    </script>

