@using eVidencia.BLL
@inject GestorUsuarios GestorUsuarios
@{
    // Menú lateral por módulos. Diseño y entradas: mockup responsive.
    // Se pinta el menú del perfil Administrador (Menu.ascx.cs:30-56 del original).
    // Están migrados "Sociedades", "Procesos" y "Subprocesos" (Administración); el resto de entradas se muestra sin enlace.
    string ruta = Context.Request.Path.Value ?? "";
    bool enProcesos = ruta.StartsWith("/Administracion/Proceso", StringComparison.OrdinalIgnoreCase);
    bool enSociedades = ruta.StartsWith("/Administracion/Sociedad", StringComparison.OrdinalIgnoreCase);
    bool enSubprocesos = ruta.StartsWith("/Administracion/Subproceso", StringComparison.OrdinalIgnoreCase);
    bool esAdministrador = GestorUsuarios.ConsultarUsuarioAutenticado().IdPerfilDeUsuario == (int)PerfilDeUsuario.Administrador;
    const string NoMigrado = "No incluido en la demo";
}
@if (esAdministrador)
{
<div class="ev-sec" data-sec="auditores">
  <button type="button" class="ev-sec__head" aria-expanded="true"><span>Auditores</span><svg class="ev-i" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
  <div class="ev-sec__items">
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg><span>Procesos</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"></path></svg><span>Evidencias</span></span>
  </div>
</div>
<div class="ev-sec" data-sec="reportes">
  <button type="button" class="ev-sec__head" aria-expanded="true"><span>Reportes</span><svg class="ev-i" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
  <div class="ev-sec__items">
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V10M12 20V4M19 20v-7"></path></svg><span>Dashboard</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 17v-3M13 17v-5M16 17v-2"></path></svg><span>A.C. Proc. de Audit.</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 17v-3M13 17v-5M16 17v-2"></path></svg><span>A.C. Proc. o Subpr.</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 17v-3M13 17v-5M16 17v-2"></path></svg><span>A.C. Resp. o Usuar.</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 17v-3M13 17v-5M16 17v-2"></path></svg><span>Planific. y Evidenc.</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 17v-3M13 17v-5M16 17v-2"></path></svg><span>Proc. sin Audit.</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 17v-3M13 17v-5M16 17v-2"></path></svg><span>Contr. sin Resp.</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 17v-3M13 17v-5M16 17v-2"></path></svg><span>Camb. en Evidenc.</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 17v-3M13 17v-5M16 17v-2"></path></svg><span>Cons. de Evidenc.</span></span>
  </div>
</div>
<div class="ev-sec is-active" data-sec="administracion">
  <button type="button" class="ev-sec__head" aria-expanded="true"><span>Administración</span><svg class="ev-i" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
  <div class="ev-sec__items">
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM3 20c.5-3.5 3-5.5 6-5.5s5.5 2 6 5.5M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5c1.7.6 2.8 2.4 3 5.5"></path></svg><span>Usuarios</span></span>
    <a class="ev-nav__link @(enSociedades ? "is-current" : "")" href="/Administracion/Sociedades.aspx" aria-current="@(enSociedades ? "page" : null)"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V5l8-2v18M12 8h8v13M3 21h18M8 9v.01M8 13v.01M8 17v.01M16 12v.01M16 16v.01"></path></svg><span>Sociedades</span></a>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v14H4zM4 10h16M8 3v4M16 3v4"></path></svg><span>Periodos</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 2.5 20h19zM12 10v4M12 17v.5"></path></svg><span>Riesgos</span></span>
    <a class="ev-nav__link @(enProcesos ? "is-current" : "")" href="/Administracion/Procesos.aspx" aria-current="@(enProcesos ? "page" : null)"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg><span>Procesos</span></a>
    <a class="ev-nav__link @(enSubprocesos ? "is-current" : "")" href="/Administracion/Subprocesos.aspx" aria-current="@(enSubprocesos ? "page" : null)"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg><span>Subprocesos</span></a>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8zM7.5 7.5v.01"></path></svg><span>Tipos de Auditoría</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M14 4v4M8 10v4M16 16v4"></path></svg><span>Parámetros</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"></path></svg><span>Áreas Responsab.</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h12l-3-3M17 17H5l3 3"></path></svg><span>Sustitución Masiva</span></span>
    <span class="ev-nav__link is-off has-gap" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6v.01M4 12v.01M4 18v.01"></path></svg><span>Logs de Entidades</span></span>
    <span class="ev-nav__link is-off" title="@NoMigrado"><svg class="ev-i ev-i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6v.01M4 12v.01M4 18v.01"></path></svg><span>Logs de Sistema</span></span>
  </div>
</div>
}
